{
  "outputs": {
    "default": "pluginmaster.json",
    "testers": "testers.json"
  },
  "plugins": {
    "WigglyQuest": {
      "url": "https://github.com/WigglyCorp/WigglyQuest",
      "enabled": true,
      "output": "default",
      "token": "PLUGIN_PAT"
    },
    "Influx": {
      "url": "https://github.com/WigglyMuffin/Influx",
      "enabled": true,
      "output": "default",
      "token": "PLUGIN_PAT"
    },
    "Questionable Companion": {
      "url": "https://github.com/MacaronDream/QSTCompanion",
      "enabled": true,
      "output": "default",
      "token": "PLUGIN_PAT"
    },
    "QuestionableConverter": {
      "url": "https://github.com/WigglyMuffin/QuestionableConverter",
      "token": "PLUGIN_PAT",
      "output": "default",
      "enabled": true,
      "displayName": "Questionable Converter"
    },
    "WigglyTester": {
      "url": "https://github.com/WigglyMuffin/WigglyTester",
      "enabled": true,
      "output": "testers",
      "token": "PLUGIN_PAT"
    }
  }
}
